<Page x:Class="FinalProject.Pages.C_Reply"
      xmlns:hc="https://handyorg.github.io/handycontrol"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:FinalProject.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="700"
      Title="C_Reply">
    <!--<Page.Resources>
        <ResourceDictionary>
            <local:DoubleToIntConverter x:Key="DoubleToIntConverter"/>
        </ResourceDictionary>
    </Page.Resources>-->
   
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/MyPicture/דף2.png"/>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="0.30*"/>
            <RowDefinition/>

        </Grid.RowDefinitions>
        <WrapPanel HorizontalAlignment="Right"  FlowDirection="LeftToRight" VerticalAlignment="Center">
            <Button HorizontalAlignment="Right" Content="לצפיה בתגובות"  Background="{x:Null}" FontSize="12" FontWeight="Bold" Margin="10" BorderThickness="3" BorderBrush="#FFBE9C6C" Height="30" Click="Button_Click"/>
            <Button HorizontalAlignment="Right" Content="דף הבית"  Background="{x:Null}" FontSize="12" FontWeight="Bold" Margin="10" BorderThickness="3" BorderBrush="#FFBE9C6C" Height="30" Click="Button_Click_1"/>
        </WrapPanel>
      
        <StackPanel Grid.Row="1" FlowDirection="RightToLeft"  >
            <TextBlock Text="איך היה חוויתכם בסטודיו? שתפו אותנו...." FontSize="16"/>
            <TextBlock Text="הכנס ת.ז לקוח " Margin="5"/>
            <TextBox x:Name="idc" Width="200" HorizontalAlignment="Left" TextAlignment="Right" Margin="5 0 5 10"  Style="{StaticResource error}" >
                <Binding Path="Id" UpdateSourceTrigger="PropertyChanged" >
                    <Binding.ValidationRules>
                        <local:IsID />
                    </Binding.ValidationRules>
                </Binding>
            </TextBox>
            <!--<hc:Rate x:Name="rate"   MouseDown="Rate_MouseDown" Value="{Binding Rating }"  />-->
            <!--<hc:Rate x:Name="feedbackRating" Value="{Binding  Rating, Mode=TwoWay}" MouseDown="Rate_MouseDown"/--><!-->-->
            <hc:Rate x:Name="feedbackRating"  ValueChanged="FeedbackRating_ValueChanged" Foreground="#FFBE9C6C"/>

            <TextBox x:Name="fc"  BorderBrush="Black" BorderThickness="3"  HorizontalAlignment="Left" Width="300" Height="120"  Margin="10" TextWrapping="Wrap" Style="{StaticResource error}" TextAlignment="Left" >
                <Binding Path="TextFeedback" UpdateSourceTrigger="PropertyChanged" >
                    <Binding.ValidationRules>
                        <local:isHebrewRule2 />
                    </Binding.ValidationRules> 
                </Binding>
            </TextBox>
            
            <Button Content="שליחה" Width="100" Background="{x:Null}" Height="32" FontSize="14" FontWeight="Bold" Click="send" BorderBrush="Black"/>
            
            
        </StackPanel>

    </Grid>
</Page>
