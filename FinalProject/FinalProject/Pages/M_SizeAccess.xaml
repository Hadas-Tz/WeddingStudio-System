<Page x:Class="FinalProject.Pages.M_SizeAccess"  Background="White"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:FinalProject.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="M_SizeAccess">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="0.25*" />
        </Grid.RowDefinitions>

        <ListView x:Name="lvas"   FlowDirection="RightToLeft"  FontWeight="Bold"  >
            <ListView.View  >
                <GridView>
                    <GridViewColumn Header="קוד" Width="90"  DisplayMemberBinding="{Binding CodeSizeAccess}" />
                    <GridViewColumn Header="קוד אביזר" Width="90"  DisplayMemberBinding="{Binding CodeAccess }" />
                    <GridViewColumn Header="תאור" Width="200"  DisplayMemberBinding="{Binding   Accessory.Descripation }" />
                    <GridViewColumn Header="תמונה" Width="100"  DisplayMemberBinding="{Binding  Accessory.Image }" />
                    <GridViewColumn Header="מידה" Width="90"  DisplayMemberBinding="{Binding Size.Size1 }" />
                    <GridViewColumn Header="כמות במלאי"   Width="120"  DisplayMemberBinding="{Binding AmountStoke }" />
                    <GridViewColumn Header="סטטוס" Width="90" DisplayMemberBinding="{Binding Status}" />
               
                </GridView>
            </ListView.View>
        </ListView>
        <WrapPanel Grid.Row="1">
           
            <Button Content="Update" Click="UpdateButton" BorderBrush="#FFBE9C6C"   Margin="20 0 5 0"    Height="30" Background="{x:Null}" BorderThickness="3"/>

            <Button Content="Cancel"  Click="CancelButton"  BorderBrush="#FFBE9C6C"  Margin="5"   Height="30" Background="{x:Null}" BorderThickness="3"/>
        </WrapPanel>
    </Grid>
</Page>
