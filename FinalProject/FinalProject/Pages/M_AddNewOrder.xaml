<Window x:Class="FinalProject.Pages.M_AddNewOrder"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FinalProject.Pages"
        mc:Ignorable="d"
        Title="M_AddNewOrder" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="1.2*"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid Background="White"  Grid.Column="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="167*"/>
                <ColumnDefinition Width="18*" />
                <ColumnDefinition Width="115*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="50*"/>

                <RowDefinition Height="39*" />
                <RowDefinition Height="39*"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="39*" />
                <RowDefinition Height="40"/>
                <RowDefinition Height="39*" />
                <RowDefinition Height="39*"/>
                <RowDefinition Height="39.338"/>
                <RowDefinition Height="39*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Column="2" Grid.Row="1" Text="ת.ז " TextAlignment="Right" FontSize="20" FontWeight="Bold"  Foreground="#FF333333"  />
            <TextBlock Grid.Column="2" Grid.Row="2" Text="תאריך אירוע " TextAlignment="Right" FontSize="18" FontWeight="Bold"  Foreground="#FF333333"  />
            <TextBlock Grid.Column="2" Grid.Row="8" Text=" מס תשלומים" TextAlignment="Right" FontSize="18" FontWeight="Bold" Foreground="#FF333333"    />
            <TextBlock Grid.Column="2" Grid.Row="3" Text="הזמנת שמלה" TextAlignment="Right" FontSize="18" FontWeight="Bold" Foreground="#FF333333"  />
            <TextBlock Grid.Column="2" Grid.Row="5" Text="הזמנת אביזר " TextAlignment="Right" FontSize="18" FontWeight="Bold" Foreground="#FF333333"    />
            <TextBlock Grid.Column="2" Grid.Row="7" Text="שיטת תשלום" TextAlignment="Right" FontSize="18" FontWeight="Bold" Foreground="#FF333333"   />
            <Image Source="/MyPicture/לוגו קטן.png" Width="100" HorizontalAlignment="Left" Margin="5,0,0,39" Grid.RowSpan="2" />


            <TextBox x:Name="id"  Grid.Row="1" FontSize="16" BorderBrush="#FFBE9C6C"  BorderThickness="3"  Style="{StaticResource error}" Height="30" >
                <Binding Path="Id" UpdateSourceTrigger="PropertyChanged">
                    <Binding.ValidationRules>
                        <local:IsID />
                    </Binding.ValidationRules>
                </Binding>
            </TextBox>

            <DatePicker x:Name="dp" Grid.Row="2" FontSize="16" BorderBrush="#FFBE9C6C"  BorderThickness="3" SelectedDate="{Binding Date}" Height="30" >
            </DatePicker>


            <TextBox x:Name="ao" Grid.Row="5"  BorderBrush="#FFBE9C6C"  BorderThickness="3" Height="25" Margin="0,0,0,10"  Style="{StaticResource error}" >
                <Binding Path="OrderAccess.AcccessoryCode" UpdateSourceTrigger="PropertyChanged">
                    <Binding.ValidationRules>
                        <local:IsNumber />
                    </Binding.ValidationRules>
                </Binding>
            </TextBox>
            <TextBlock Grid.Row="3" Text="הכנס קוד שמלה " TextAlignment="Center" Margin="0,26,0,0"  FontSize="9" />
            <Button Content="הוסף שמלה "  Grid.Row="4"  BorderBrush="#FFBE9C6C"  BorderThickness="3" Click="Button_Click_2" Width="80" Background="{x:Null}" FontSize="9" HorizontalAlignment="Left" Margin="38,0,0,0"  />

            <TextBox x:Name="dro" Grid.Row="3"  BorderBrush="#FFBE9C6C"  BorderThickness="3" Height="25" Margin="0,0,0,10"  Style="{StaticResource error}" >
                <Binding Path="OrderDress.DressCode" UpdateSourceTrigger="PropertyChanged">
                    <Binding.ValidationRules>
                        <local:IsNumber />
                    </Binding.ValidationRules>
                </Binding>
            </TextBox>
            <TextBlock Grid.Row="5" Text="הכנס קוד אביזר " TextAlignment="Center" Margin="0,27,0,1" FontSize="9" />
            <Button Content="הוסף אביזר "  Grid.Row="6"  BorderBrush="#FFBE9C6C"  BorderThickness="3" Click="Button_Click_1" Width="80" Background="{x:Null}" FontSize="9" HorizontalAlignment="Left" Margin="38,0,0,0"  />
            <!--<TextBox Name="mp" Grid.Row="7" BorderBrush="#FFBE9C6C" BorderThickness="3" Height="30" Style="{StaticResource error}"  TextAlignment="Right" >
                <Binding Path="Payments.MethodPayment" UpdateSourceTrigger="PropertyChanged">
                    <Binding.ValidationRules>
                        <local:IsNumber />
                    </Binding.ValidationRules>
                </Binding>
            </TextBox>-->

            <RadioButton x:Name="a" Grid.Row="7" FontSize="10" Content="מזומן" HorizontalAlignment="Right" FlowDirection="RightToLeft" />
            <RadioButton x:Name="b" Grid.Row="7" FontSize="10" Content="העברה בנקאית" HorizontalAlignment="Left" FlowDirection="RightToLeft" Margin="30,0,0,0" />
            <RadioButton x:Name="t" Grid.Row="7" FontSize="10" Content="צ'ק" HorizontalAlignment="Left" FlowDirection="RightToLeft" Margin="-11,0,0,0"/>

            <TextBox x:Name="np" Grid.Row="8" BorderBrush="#FFBE9C6C"  BorderThickness="3" Height="30" Style="{StaticResource error}" >
                <Binding Path="Payments.NumPayment" UpdateSourceTrigger="PropertyChanged">
                    <Binding.ValidationRules>
                        <local:IsNumber />
                    </Binding.ValidationRules>
                </Binding>
            </TextBox>
            <Button Content="Save" Grid.Row="9" BorderBrush="#FFBE9C6C" BorderThickness="2" Click="Button_Click" Height="28" Width="49"/>

        </Grid>
    </Grid>
</Window>
