<Window x:Class="FinalProject.Pages.M_OrderDiteil"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FinalProject.Pages"
        mc:Ignorable="d"
        Title="M_OrderDiteil" Height="450" Width="600">
    <Grid>
        <Grid Background="White" >

            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="30"/>
                <RowDefinition />
                <RowDefinition Height="30" />
                <RowDefinition Height="90" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text=":שמלות בהזמנה" VerticalAlignment="Top " TextAlignment="Right" FontSize="16" FontWeight="Bold"/>
           
                <ListView x:Name="lvd"   FlowDirection="RightToLeft"  FontWeight="Bold" Height="50"  >
                    <ListView.View  >
                        <GridView>
                            <GridViewColumn Header="קוד שמלה" Width="100"  DisplayMemberBinding="{Binding DressCode}" />
                            <GridViewColumn Header="תאור" Width="150"  DisplayMemberBinding="{Binding dress.Descripation}" />
                            <GridViewColumn Header="מחיר" Width="120"  DisplayMemberBinding="{Binding  Price}" />
                            <GridViewColumn Header="סטטוס"      Width="120"  DisplayMemberBinding="{Binding Status }" />

                        </GridView>
                    </ListView.View>
                </ListView>
            </StackPanel>

            <WrapPanel Grid.Row="1">
                
                <Button Content="Cancel"  Click="CancelButton1"  BorderBrush="#FFBE9C6C"  Margin="5 0"   Height="30" Background="{x:Null}" BorderThickness="3"/>
            </WrapPanel>
           
            <StackPanel Grid.Row="2">
                <TextBlock Text=":אביזרים בזמנה" VerticalAlignment="Top " TextAlignment="Right" FontSize="16" FontWeight="Bold"/>
                <ListView x:Name="lva"   FlowDirection="RightToLeft"  FontWeight="Bold" Height="50"  >
                    <ListView.View  >
                    <GridView>
                        <GridViewColumn Header="קוד שמלה" Width="100"  DisplayMemberBinding="{Binding DressCode}" />
                        <GridViewColumn Header="תאור" Width="150"  DisplayMemberBinding="{Binding OrderDress.Descripation }" />
                        <GridViewColumn Header="מחיר" Width="120"  DisplayMemberBinding="{Binding  Price}" />
                        <GridViewColumn Header="סטטוס"      Width="120"  DisplayMemberBinding="{Binding Status }" />

                    </GridView>
                </ListView.View>
                </ListView>
            </StackPanel>
            <WrapPanel Grid.Row="3">
               
                <Button Content="Cancel"  Click="CancelButton"  BorderBrush="#FFBE9C6C"  Margin="5 0"   Height="30" Background="{x:Null}" BorderThickness="3"/>
            </WrapPanel >
            <StackPanel Grid.Row="4">
                <WrapPanel   FlowDirection="RightToLeft" >
                <TextBlock Text="סהכ לתשלום: " Margin="5" FontSize="16" FontWeight="Bold"/>
                    <TextBlock FontSize="14" Height="21" Text="{Binding Payments.Total}"  />
            </WrapPanel>
            <WrapPanel   FlowDirection="RightToLeft"  >
                <TextBlock Text="שיטת תשלום:" Margin="5" FontSize="16" FontWeight="Bold"/>
                    <TextBlock FontSize="14" Height="21" Text="{Binding Payments.MethodPayment}"  />
                </WrapPanel>
                <WrapPanel   FlowDirection="RightToLeft"  >
                    <TextBlock Text="מס תשלומים:" Margin="5" FontSize="16" FontWeight="Bold"/>
                    <TextBlock FontSize="14" Height="21" Text="{Binding Payments.NumPayment}"   />
                </WrapPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
