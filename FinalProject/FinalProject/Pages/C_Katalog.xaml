<Page x:Class="FinalProject.Pages.C_Katalog" Background="White"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:FinalProject.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="C_Katalog">

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Pages/מסך קטלוג.png"/>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="0.35*"/>
            <RowDefinition/>
            <RowDefinition Height="0.30*" />
        </Grid.RowDefinitions>

        <Frame Grid.Row="1" x:Name="Mfm"   ></Frame>

        <WrapPanel HorizontalAlignment="Right"  VerticalAlignment="Bottom" FlowDirection="RightToLeft">

            <Button Click="Button_Click" x:Name="bd"  Margin="0 0 15 10" Content="שמלות"  Width="100" Height="40" BorderBrush="#FFBE9C6C" Background="{x:Null}" BorderThickness="3" />


            <Menu Width="100" Height="40" Margin="0 0 15 10" BorderBrush="#FFBE9C6C" BorderThickness="3"  Background="{x:Null}"   x:Name="ac"  >
                <MenuItem Header="    אביזרים" Width="100" Height="40" VerticalAlignment="Center"  >
                    <MenuItem Header="נעלים" Click="shoes" x:Name="s"/>
                    <MenuItem Header="תכשיטים" Click="jewelry" x:Name="j"/>
                    <MenuItem Header=" אביזרי שיער" Click="hair" x:Name="h"/>
            </MenuItem>
            </Menu>
            
            <Button   x:Name="pw"  Content="דף הבית" Click="pw_Click" Margin="0 0 15 10"  Width="100" Height="40" BorderBrush="#FFBE9C6C" Background="{x:Null}" BorderThickness="3" HorizontalAlignment="Left" VerticalAlignment="Top" />
          
            
            <!--<Button x:Name="ba"   Margin="0 0 15 10" Content="אביזרים" Click="Access" Width="100" Height="40" BorderBrush="#FFBE9C6C" Background="{x:Null}" BorderThickness="3" />-->
        </WrapPanel>
    </Grid>
</Page>
