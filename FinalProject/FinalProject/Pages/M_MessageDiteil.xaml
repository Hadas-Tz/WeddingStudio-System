<Window x:Class="FinalProject.Pages.M_MessageDiteil"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FinalProject.Pages"
        mc:Ignorable="d"
        Title="M_MessageDiteil" Height="350" Width="600">
    <Grid>
        <StackPanel>
            <TextBlock Text="פירוט הודעה" TextAlignment="Center" FontSize="20"  Foreground="#FFBE9C6C" Margin="5"/>
            <TextBlock Text="ת.ז שולח" TextAlignment="Right" FontSize="14" Margin="5" Foreground="#FFBE9C6C" />
            <TextBlock Text="{Binding CustId}" TextAlignment="Right" Margin="5" />
            <TextBlock   Text="תוכן הודעה" TextAlignment="Right" FontSize="14" Margin="5" Foreground="#FFBE9C6C"/>
            <TextBlock Text="{Binding Content}" TextAlignment="Right" TextWrapping="Wrap" Width="450" Height="150" HorizontalAlignment="Right" Margin="5" />
            <CheckBox Content="סטטוס" HorizontalAlignment="Right" FontSize="14" IsChecked="{Binding Status}" Foreground="#FFBE9C6C" BorderBrush="#FFBE9C6C"  Margin="5" />

        </StackPanel>
    </Grid>
</Window>
