<Page x:Class="FinalProject.Pages.M_Menu"
              xmlns:hc="https://handyorg.github.io/handycontrol"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="700"
      Title="M_Menu">

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/MyPicture/דף2.png"/>
        </Grid.Background>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="7*"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid  Grid.Column="1" >
            <Grid.RowDefinitions>
                <RowDefinition Height="0.25*" />
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Button x:Name="pw" Content="דף הבית" Click="pw_Click"  Background="{x:Null}" BorderThickness="1.5" Height="30" Width="80" BorderBrush="Black" />
            <StackPanel Grid.Row="1" Grid.Column="1" >

                <Button x:Name="bc" Content="לקוחות" Click="ClientButton"  Height="45"  Background="{x:Null}" BorderThickness="3" Margin=" 3" Width="80"  BorderBrush="Black" />
                <Button x:Name="bd" Content="שמלות" Click="DressButton"    Height="45" BorderBrush="#FFBE9C6C" Background="{x:Null}" BorderThickness="3" Margin="0 3"
                    Width="80" />
                <Button  x:Name="ba"  Content="אביזרים" Click="AccessButton"   Height="45" BorderBrush="#FFBE9C6C" Background="{x:Null}" BorderThickness="3" Margin="0 3"
                    Width="80"/>
                <Button  x:Name="bas" Content="מידות אביזרים"    Click="SizeAccess"           Height="45" BorderBrush="#FFBE9C6C" Background="{x:Null}" BorderThickness="3" Margin="0 3"  Width="80" FontSize="9" />
               
                <Button x:Name="bo" Content="הזמנות" Click="OrderButton" Grid.Column="1" Height="45" BorderBrush="#FFBE9C6C" Background="{x:Null}" BorderThickness="3" Margin="0 3"
                    Width="80"/>

                <Button x:Name="bm" Content=" הודעות" Click="AsksButton"  Height="45" BorderBrush="#FFBE9C6C" Background="{x:Null}" BorderThickness="3" Margin="0 3"
    Width="80"/>
                <!--<hc:Rate x:Name="rate"/>-->


            </StackPanel>
        </Grid>
        <Grid >
            <Grid.RowDefinitions>
                <RowDefinition Height="0.25*"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Frame Grid.Row="1" x:Name="Mfm" BorderBrush="Black" BorderThickness="3"  ></Frame>
        </Grid>

    </Grid>

</Page>
