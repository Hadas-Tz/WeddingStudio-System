<Page x:Class="FinalProject.Pages.A" Background="White"
      xmlns:hc="https://handyorg.github.io/handycontrol"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:FinalProject.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="700"
      Title="A">
  
    <Grid >
        <Grid.Background>
            <ImageBrush ImageSource="/MyPicture/דף2.png"/>

        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="0.25*"/>
            <RowDefinition Height="0.20*" />
            <RowDefinition/>
        </Grid.RowDefinitions>
     
        <DockPanel  Grid.Row="1" HorizontalAlignment="Right"  FlowDirection="RightToLeft" VerticalAlignment="Top" >

            <Button x:Name="katalog1"   Click="katalogButton"  Content="קטלוג"     Width="110" Height="40" FontWeight="Bold" FontSize="15" BorderBrush="#FFBE9C6C" BorderThickness="3" Margin="3" Background="{x:Null}"  />
            <Button x:Name="fidback"     Content="תגובות"    Width="120" Height="40" FontWeight="Bold" BorderBrush="#FFBE9C6C" BorderThickness="3" Margin="3" Background="{x:Null}" FontSize="15" Click="feedback" />
            <Button x:Name="kesher"      Content="צור קשר"   Width="120" Height="40" FontWeight="Bold" FontSize="15" BorderBrush="#FFBE9C6C" BorderThickness="3" Margin="3" Background="{x:Null}" Click="KesherButton"/>
            <Button x:Name="odot"        Content="אודותינו"  Width="120" Height="40" FontWeight="Bold" FontSize="15" BorderBrush="#FFBE9C6C" BorderThickness="3" Margin="3" Background="{x:Null}" Click="AboutMe"/>

            
        </DockPanel>
        <DockPanel  HorizontalAlignment="Right"  FlowDirection="RightToLeft" VerticalAlignment="Top"   >
                <Button Content="למנהל"    FontWeight="Bold" FontSize="18" Width="90"   Background="{x:Null}" Click="Button_Click"  Height="35" />
            <PasswordBox x:Name="pw"   FontSize="18" MinWidth="90" Visibility="Collapsed"  Background="{x:Null}"  Height="35"/>
            <Button x:Name="cn"      Content="&lt;" FontWeight="Bold" FontSize="18" MinWidth="20" Height="35" Background="{x:Null}" Visibility="Collapsed" Click="cn_Click"/>
        </DockPanel>
       
        <Grid Grid.Row="2" Margin="20">
            <MediaElement 
              x:Name="myVideo"
    LoadedBehavior="Manual"
    UnloadedBehavior="Manual"
    Stretch="Uniform"
    Volume="1"
            />
        </Grid>


    </Grid>

</Page>
