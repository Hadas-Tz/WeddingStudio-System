<Window x:Class="FinalProject.Pages.M_AddNewClient"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FinalProject.Pages"        
        mc:Ignorable="d"
        Title="M_AddNewClient" Height="490" Width="800" >

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="1.2*"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid Background="White"  Grid.Column="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="0.2*" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Column="2" Grid.Row="1" Height="25" Text="מספר זהות " TextAlignment="Right" FontSize="20" FontWeight="Bold" Foreground="#FF333333"   />
            <TextBlock Grid.Column="2" Grid.Row="2" Height="25" Text="שם פרטי " TextAlignment="Right" FontSize="20" FontWeight="Bold"  Foreground="#FF333333"  />
            <TextBlock Grid.Column="2" Grid.Row="3" Height="25" Text="שם משפחה " TextAlignment="Right" FontSize="20" FontWeight="Bold"  Foreground="#FF333333"  />
            <TextBlock Grid.Column="2" Grid.Row="4" Height="25" Text="רחוב " TextAlignment="Right" FontSize="20" FontWeight="Bold" Foreground="#FF333333"   />
            <TextBlock Grid.Column="2" Grid.Row="5" Height="25" Text=" מס' בית " TextAlignment="Right" FontSize="20" FontWeight="Bold" Foreground="#FF333333"   />
            <TextBlock Grid.Column="2" Grid.Row="6" Height="25" Text=" עיר " TextAlignment="Right" FontSize="20" FontWeight="Bold"  Foreground="#FF333333"  />
            <TextBlock Grid.Column="2" Grid.Row="7" Height="25" Text="אימייל " TextAlignment="Right" FontSize="20" FontWeight="Bold"  Foreground="#FF333333"  />
            <TextBlock Grid.Column="2" Grid.Row="8" Height="25" Text=" פלאפון " TextAlignment="Right" FontSize="20" FontWeight="Bold" Foreground="#FF333333" />
            <TextBlock Grid.Column="2" Grid.Row="9" Height="25" Text="סטטוס " TextAlignment="Right" FontSize="20" FontWeight="Bold" Foreground="#FF333333" />

            <Image Source="/MyPicture/לוגו קטן.png" Width="100" HorizontalAlignment="Left" Margin="5,0,0,0" />
            <TextBox Grid.Row="1" x:Name="Id" Height="30" FontSize="16" BorderBrush="#FFBE9C6C"  BorderThickness="3"   Style="{StaticResource error}">
                <Binding Path="Id" UpdateSourceTrigger="PropertyChanged" >
                    <Binding.ValidationRules>
                        <local:IsID />
                    </Binding.ValidationRules>
                </Binding>
            </TextBox>
            <TextBox x:Name="fn"  Grid.Row="2" Height="30" FontSize="16" BorderBrush="#FFBE9C6C"  BorderThickness="3" TextAlignment="Right" Style="{StaticResource error}" >
                <Binding Path="Fname" UpdateSourceTrigger="PropertyChanged">
                    <Binding.ValidationRules>
                        <local:isHebrewRule2 />
                    </Binding.ValidationRules>
                </Binding>
            </TextBox>
            <TextBox x:Name="ln" Grid.Row="3" Height="30" FontSize="16" BorderBrush="#FFBE9C6C"  BorderThickness="3"  TextAlignment="Right" Style="{StaticResource error}">
                <Binding Path="Lname" UpdateSourceTrigger="PropertyChanged">
                    <Binding.ValidationRules>
                        <local:isHebrewRule2 />
                    </Binding.ValidationRules>
                </Binding>
            </TextBox>
            <TextBox x:Name="st" Grid.Row="4" Height="30" FontSize="16" BorderBrush="#FFBE9C6C"  BorderThickness="3" TextAlignment="Right"  Style="{StaticResource error}">
                <Binding Path="Street"  UpdateSourceTrigger="PropertyChanged">
                    <Binding.ValidationRules>
                        <local:isHebrewRule2 />
                    </Binding.ValidationRules>
                </Binding>
            </TextBox>
            
          
            <TextBox x:Name="hn"  Grid.Row="5" Height="30" FontSize="16" BorderBrush="#FFBE9C6C"  BorderThickness="3"  Style="{StaticResource error}" >
                <Binding Path="House_Num" UpdateSourceTrigger="PropertyChanged">
                    <Binding.ValidationRules>
                        <local:IsNumber />
                    </Binding.ValidationRules>
                </Binding>
            </TextBox>
            <ComboBox x:Name="Cmb"  Grid.Row="6" Height="30" FontSize="16" BorderBrush="#FFBE9C6C"  BorderThickness="3"
             DisplayMemberPath="Name" SelectedItem="{Binding City}"/>
            
            <TextBox x:Name="em"  Grid.Row="7" Height="30" FontSize="16" BorderBrush="#FFBE9C6C"  BorderThickness="3" Style="{StaticResource error}" >
                <Binding Path="Email" UpdateSourceTrigger="PropertyChanged">
                    <Binding.ValidationRules>
                        <local:EmailRule2 />
                    </Binding.ValidationRules>
                </Binding>
            </TextBox>
            <TextBox x:Name="pn" Grid.Row="8" Height="30" FontSize="16" BorderBrush="#FFBE9C6C"  BorderThickness="3" Style="{StaticResource error}" >
                <Binding Path="Phon_Num" UpdateSourceTrigger="PropertyChanged">
                    <Binding.ValidationRules>
                        <local:IsCellPhone/>
                    </Binding.ValidationRules>
                </Binding>
            </TextBox>
            <CheckBox  Grid.Row="9" Height="30"  BorderBrush="#FFBE9C6C"  BorderThickness="3" HorizontalAlignment="Right" IsChecked="{Binding Status}" />

            <Button Content="Save" Grid.Row="10" BorderBrush="#FFBE9C6C" BorderThickness="2" Click="Button_Click"/>
            
 
        </Grid>
    </Grid>
 
</Window>
