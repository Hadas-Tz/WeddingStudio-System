<Window x:Class="FinalProject.Pages.M_AddNewDress"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FinalProject.Pages"
        mc:Ignorable="d"
        Title="M_AddNewDress" Height="490" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="1.2*"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid Background="White"  Grid.Column="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="0.2*" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="50"/>
                <RowDefinition />
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
           
            <TextBlock Grid.Column="2" Grid.Row="1" Height="25" Text="תאור" TextAlignment="Right" FontSize="20" FontWeight="Bold"  Foreground="#FF333333"  />
            <TextBlock Grid.Column="2" Grid.Row="2" Height="25" Text="צבע " TextAlignment="Right" FontSize="20" FontWeight="Bold"  Foreground="#FF333333"  />
            <TextBlock Grid.Column="2" Grid.Row="3" Height="25" Text="מידה " TextAlignment="Right" FontSize="20" FontWeight="Bold" Foreground="#FF333333"   />
            <TextBlock Grid.Column="2" Grid.Row="4" Height="25" Text=" אורך " TextAlignment="Right" FontSize="20" FontWeight="Bold" Foreground="#FF333333"   />
            <TextBlock Grid.Column="2" Grid.Row="5" Height="25" Text=" מחיר " TextAlignment="Right" FontSize="20" FontWeight="Bold"  Foreground="#FF333333"  />
           
            <TextBlock Grid.Column="2" Grid.Row="6" Height="25" Text=" תמונה " TextAlignment="Right" FontSize="20" FontWeight="Bold" Foreground="#FF333333" />
           
            <TextBlock Grid.Column="2" Grid.Row="8" Height="25" Text="סטטוס " TextAlignment="Right" FontSize="20" FontWeight="Bold" Foreground="#FF333333" />

            <Image Source="/MyPicture/לוגו קטן.png" Width="100" HorizontalAlignment="Left" Margin="5,0,0,0" />
           
            <TextBox x:Name="dd"  Grid.Row="1" Height="50" FontSize="16" BorderBrush="#FFBE9C6C"  BorderThickness="3" TextAlignment="Right" Style="{StaticResource error}" TextWrapping="Wrap"  >
                <Binding Path="Descripation" UpdateSourceTrigger="PropertyChanged">
                    <Binding.ValidationRules>
                        <local:isHebrewRule2 />
                    </Binding.ValidationRules>
                </Binding>
            </TextBox>
            <TextBox x:Name="cd" Grid.Row="2" Height="30" FontSize="16" BorderBrush="#FFBE9C6C"  BorderThickness="3"  TextAlignment="Right" Style="{StaticResource error}">
                <Binding Path="Color" UpdateSourceTrigger="PropertyChanged">
                    <Binding.ValidationRules>
                        <local:isHebrewRule2 />
                    </Binding.ValidationRules>
                </Binding>
            </TextBox>
            <ComboBox x:Name="csd" Grid.Row="3" Height="30" FontSize="16" BorderBrush="#FFBE9C6C"  BorderThickness="3" 
              DisplayMemberPath="Size1" SelectedItem="{Binding Size1}"/>





            <TextBox x:Name="ld"  Grid.Row="4" Height="30" FontSize="16" BorderBrush="#FFBE9C6C"  BorderThickness="3"  Style="{StaticResource error}" >
                <Binding Path="Long" UpdateSourceTrigger="PropertyChanged">
                    <Binding.ValidationRules>
                        <local:IsNumber />
                    </Binding.ValidationRules>
                </Binding>
            </TextBox>


            <TextBox x:Name="pd"  Grid.Row="5" Height="30" FontSize="16" BorderBrush="#FFBE9C6C"  BorderThickness="3" Style="{StaticResource error}" >
                <Binding Path="Price" UpdateSourceTrigger="PropertyChanged">
                    <Binding.ValidationRules>
                        <local:IsNumber/>
                    </Binding.ValidationRules>
                </Binding>
            </TextBox>
            <Image x:Name="pc"  Grid.Row="6" Width="73" Height="73"  Margin="91 0 0 0" Grid.RowSpan="2"   />
            <Button Content="בחר תמונה" Height="30"  Grid.Row="7"   Margin="0 0 70 0" BorderBrush="#FFBE9C6C"  BorderThickness="3"  Foreground="#FF333333" Click="Button_Click_1"/>
            <CheckBox  Grid.Row="8" Height="30"  BorderBrush="#FFBE9C6C"  BorderThickness="3" HorizontalAlignment="Right" IsChecked="{Binding Status}" />

            <Button Content="Save" Grid.Row="9" BorderBrush="#FFBE9C6C" BorderThickness="2" Click="Button_Click" />


        </Grid>
    </Grid>
</Window>
