<Window x:Class="MessageManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MessageManager"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid >
        <!--<Grid.Background>
            --><!--<ImageBrush ImageSource="/דף2.png/"/>--><!--
        </Grid.Background>-->
        <Grid.RowDefinitions>
            <RowDefinition Height="0.20*"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="1">
            <TextBlock Text="הודעות למנהל" TextAlignment="Center" FontSize="25" Foreground="#FFBE9C6C" />
            <TextBlock Text="הכנס ת.ז שולח" TextAlignment="Right" Width="112" Height="30" HorizontalAlignment="Right" FontSize="14" FontWeight="Bold"  />
            <TextBox x:Name="tb"  Width="200" Height="30" HorizontalAlignment="Right" BorderBrush="Black"  Margin="0 5" Style="{StaticResource error}">
                <Binding Path="CustId" UpdateSourceTrigger="PropertyChanged" >
                    <Binding.ValidationRules>
                        <local:IsID />
                    </Binding.ValidationRules>
                </Binding>
            </TextBox>
            <TextBlock Text="תוכן ההודעה" TextAlignment="Right" Width="100" Height="30" HorizontalAlignment="Right" FontSize="14" FontWeight="Bold"/>
            <TextBox x:Name="tb1"  TextAlignment="Right" BorderBrush="Black" Width="500" Height="100" HorizontalAlignment="Right"
            Style="{StaticResource error}">
                <Binding Path="Content" UpdateSourceTrigger="PropertyChanged" >
                    <Binding.ValidationRules>
                        <local:isHebrewRule2 />
                    </Binding.ValidationRules>
                </Binding></TextBox>
            <Button Click="Button_Click" Background="{x:Null}"  BorderBrush="Black" Width="100" Height="30"  Margin="10"  >Save Message</Button>
        </StackPanel>
    </Grid>
</Window>


